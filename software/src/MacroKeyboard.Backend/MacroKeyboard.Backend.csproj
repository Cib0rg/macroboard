<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-MacroKeyboard.Backend-e8b5c9d1-4f3a-4c8e-9f2a-1d3e5f7a9b1c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacroKeyboard.Core\MacroKeyboard.Core.csproj" />
    <ProjectReference Include="..\MacroKeyboard.Communication\MacroKeyboard.Communication.csproj" />
    <ProjectReference Include="..\MacroKeyboard.Infrastructure\MacroKeyboard.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    After the backend builds, package the HA native plugin as a ZIP file and place it in
    the plugins/ directory. PluginManager auto-extracts it on startup and re-extracts
    whenever the ZIP is newer than the previously extracted directory.

    Flow: dotnet publish → temp dir → ZipDirectory → plugins/com.macrokeyboard.homeassistant.zip
    No .NET runtime is bundled — the plugin is framework-dependent and uses the host's runtime.
  -->
  <Target Name="PackageHaPlugin" AfterTargets="Build">
    <PropertyGroup>
      <HaPluginCsproj>$(MSBuildThisFileDirectory)..\MacroKeyboard.Plugin.HomeAssistant\MacroKeyboard.Plugin.HomeAssistant.csproj</HaPluginCsproj>
      <!-- Trailing backslash omitted — a \ before &quot; escapes it and breaks the command -->
      <HaPluginTmp>$(OutputPath)plugins\_ha_tmp</HaPluginTmp>
      <HaPluginZip>$(OutputPath)plugins\com.macrokeyboard.homeassistant.zip</HaPluginZip>
    </PropertyGroup>

    <MakeDir Directories="$(OutputPath)plugins" />
    <RemoveDir Directories="$(HaPluginTmp)" ContinueOnError="true" />

    <Exec Command="dotnet publish &quot;$(HaPluginCsproj)&quot; -o &quot;$(HaPluginTmp)&quot; -v minimal"
          ConsoleToMSBuild="true"
          ContinueOnError="true" />

    <Delete Files="$(HaPluginZip)" ContinueOnError="true" />
    <ZipDirectory SourceDirectory="$(HaPluginTmp)" DestinationFile="$(HaPluginZip)" Overwrite="true" />
    <RemoveDir Directories="$(HaPluginTmp)" ContinueOnError="true" />
  </Target>

</Project>
