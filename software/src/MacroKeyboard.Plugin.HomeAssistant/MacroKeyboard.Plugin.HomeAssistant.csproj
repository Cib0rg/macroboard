<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MacroKeyboard.Plugin.HomeAssistant</AssemblyName>
    <RootNamespace>MacroKeyboard.Plugin.HomeAssistant</RootNamespace>
    <!-- Framework-dependent: uses the .NET runtime already installed with MacroKeyboard.
         RuntimeIdentifier=win-x64 generates an .exe apphost stub so the manifest
         can point to MacroKeyboard.Plugin.HomeAssistant.exe without needing "dotnet" prefix. -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.0" />
    <PackageReference Include="SixLabors.Fonts" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- These files must travel alongside the exe in both build output and dotnet publish output. -->
    <None Include="pi.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Include="manifest.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
